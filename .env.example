DICEHOARD_HOST=dnd.turnr.net

# Keep this a URL-safe random value (for example: `openssl rand -hex 32`).
MONGO_INITDB_ROOT_USERNAME=dicehoard
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-long-random-hex-password

# Host directory used for persistent Mongo data, uploads, and backups.
DICEHOARD_DATA_DIR=/data/appdata/dicehoard
